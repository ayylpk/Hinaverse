# Hinaverse 生产环境变量模板：服务器上 cp .env.example .env 后逐项填写
# ⚠️ .env 不入库（已在 .gitignore）；UTF-8 无 BOM

# ── MySQL（复用 agentmemory compose 的 mysql 容器，走 docker 内网）──
# 主机名以 `docker network inspect agentmemory_default` 实际看到的为准
# （AgentMemory compose 里服务名叫 mysql、容器名可能是 am-mysql，两个都能解析）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=*** agentmemory 目录 .env 里的 MYSQL_ROOT_PASSWORD，一致即可>
MYSQL_DATABASE=hinaverse

# ── JWT 签名密钥（生产必须换强随机）──
# 生成：openssl rand -hex 32
HINA_SECRET_KEY=***

# ── 运营台首管理员注册码（注册完首个 admin 后通道自动永久关闭）──
# 生成：openssl rand -hex 16   ← 生成后记下来，部署收尾注册管理员要用
HINA_ADMIN_INIT_CODE=

*** ── AgentMemory 记忆服务（同 docker 网络内直连容器，宿主端口映射 3000 是给 nginx 的）──
# 端口以 AgentMemory 容器内部为准（compose 里 3000:3001 → 容器内是 3001）
AGENT_MEMORY_BASE_URL=http://backend:3001
AGENT_MEMORY_PROJECT=Hinaverse
# 服务器 agentmemory 库里 Hinaverse 项目行的 api_key（与本地开发用的是同一把，
# 8/31 拍板不轮换；值见本地 backend-Hinaverse/.env）
AGENT_MEMORY_API_KEY=

*** ── DeepSeek（图引擎 LLM，值从本地 agent-Hinaverse/.env 原样拷）──
DEEPSEEK_API_KEY=
