# Hinaverse 生产环境变量模板：服务器上 cp .env.example .env 后逐项填写
# ⚠️ .env 不入库（已在 .gitignore）；UTF-8 无 BOM

# ── MySQL（复用已有的 am-mysql 容器，走 docker 内网）──
# 9/17：AgentMemory 应用层下线，但它的 mysql 容器（am-mysql）保留继续当数据库。
# Hinaverse 容器与它同在 agentmemory_default 网络里，按容器别名 mysql 直连。
# 密码 = am-mysql 的 root 密码（即 agentmemory 目录 .env 里的 MYSQL_ROOT_PASSWORD）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hinaverse

# ── JWT 签名密钥（生产必须换强随机）──
# 生成：openssl rand -hex 32
HINA_SECRET_KEY=

# ── 运营台首管理员注册码（注册完首个 admin 后通道自动永久关闭）──
# 生成：openssl rand -hex 16   ← 生成后记下来，部署收尾注册管理员要用
HINA_ADMIN_INIT_CODE=

# ── 分层记忆阈值（可选；不填用代码默认值，见 app/hina_memory/scheduler.py）──
#   HINA_MEM_L1_CUMULATIVE   L1 触发点，默认 "2,6,14,30,62"（块 2/4/8/16/32）
#   HINA_MEM_L2_INTERVAL     L1 到顶后每 +N 条推 1 条进 L2，默认 32
#   HINA_MEM_PORTRAIT_EVERY  L2 满几次刷新画像，默认 4
#   HINA_MEM_WINDOW          近期保护窗（最近 N 条不参与压缩），默认 8

# ── DeepSeek（图引擎 LLM，值从本地 agent-Hinaverse/.env 原样拷）──
DEEPSEEK_API_KEY=

# ── 极光推送（安卓壳离线通知；缺失时后端静默降级，只打日志不报错）──
# 极光控制台「我的应用 → 应用设置」里取；与壳工程 capacitor.config.json 的 appkey 必须同一把
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
